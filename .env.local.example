# ─── Groq API (FREE tier — no credit card, very generous limits) ───
# Get a key in 30 seconds at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ─── Groq model (optional; defaults to llama-3.3-70b-versatile) ───
# Free tier options (30 RPM / 14,400 RPD for all of these):
#   llama-3.3-70b-versatile  → smartest, recommended default
#   llama-3.1-8b-instant     → fastest, still excellent quality
#   llama-4-scout-17b-16e-instruct → newer, 512K context
#   qwen/qwen3-32b           → great reasoning
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Firebase client config (public — safe to expose) ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
